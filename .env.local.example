# Copy this file to .env.local and add your own key:
#   cp .env.local.example .env.local
# Never commit .env.local - it is ignored by git.
#
# Optional: Gemini API key used ONLY for the plain-language explanation layer.
# Without a key the app still works and falls back to deterministic
# template explanations. Get a key at https://aistudio.google.com/
# (GOOGLE_API_KEY is also accepted as an alternative variable name.)
GEMINI_API_KEY=your-own-api-key-here
